<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base Activity theme. The real UI theme (dark + lime accent) is defined in Compose
      (see presentation/theme). This XML theme only needs to provide a dark window
      background so there is no white flash before Compose draws.
    -->
    <style name="Theme.KickPredict" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pitch_black</item>
        <item name="android:statusBarColor">@color/pitch_black</item>
        <item name="android:navigationBarColor">@color/pitch_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
